# Configuration Firebase du projet de l'association.
# Copiez ce fichier en `.env`, remplissez les valeurs (Console Firebase > Paramètres
# du projet > Vos applications > App Web > Config SDK), puis relancez `npx expo start`.
# Tant que ce fichier n'existe pas, l'application tourne en mode démo (contenu
# local, aucune donnée envoyée).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Notifications push web : Console Firebase > Paramètres du projet > Cloud
# Messaging > Certificats Web push > Generate key pair.
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
